# ---------------------------------------------------------------------------
# MCP for Copilot — example configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# ---------------------------------------------------------------------------

# -- LLM provider -----------------------------------------------------------
# Only "openai" is implemented.
LLM_PROVIDER=openai

# Model id or alias. Aliases: gpt-6, gpt6, sol, luna, astra, gpt-5.6
LLM_MODEL_ID=gpt-6-sol

# Your provider API key. REQUIRED. Never commit this value.
LLM_API_KEY=sk-your-key-here

# OpenAI-compatible base URL (no trailing /chat/completions).
LLM_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT_SECONDS=120

# Reasoning effort: none | low | medium | high | xhigh | max
# Leave empty to omit the field. It is forced to "none" whenever tools are
# present, because the GPT-6 family rejects tools + reasoning_effort together.
LLM_REASONING_EFFORT=

# -- LLM fallback provider (Z.ai / GLM) -------------------------------------
# When the primary provider is unreachable (transport error, timeout, or 5xx)
# the same request is retried once against this backup endpoint. A 4xx is never
# retried. The fallback is disabled unless a key is set below.
LLM_FALLBACK_ENABLED=true

# Z.ai API key. Leave empty to disable the fallback. ZAI_API_KEY is also
# honoured as an alias, so an exported ZAI_API_KEY is picked up automatically.
LLM_FALLBACK_API_KEY=

# Z.ai OpenAI-compatible base URL (no trailing /chat/completions).
LLM_FALLBACK_BASE_URL=https://api.z.ai/api/paas/v4

# Fallback model id or alias. Aliases: zai, glm, glm-flash, zai-flash, glm51.
# Defaults to the cheap GLM Flash tier; use glm-5 (mid) or glm-5.1 (hard).
LLM_FALLBACK_MODEL_ID=glm-4.5-flash

LLM_FALLBACK_TIMEOUT_SECONDS=120

# -- MCP server -------------------------------------------------------------
# stdio: a command to spawn, e.g. "python -m my_mcp_server"
# http / sse: a URL, e.g. "http://127.0.0.1:9000/mcp"
# Leave empty with MCP_TRANSPORT=stdio to use the bundled gateway MCP server.
MCP_SERVER_URL=

MCP_TRANSPORT=stdio

# Bearer token for http/sse transports. Leave empty for stdio.
MCP_AUTH_TOKEN=

# -- Multiple MCP servers (optional) ----------------------------------------
# JSON array. When set, MCP_SERVERS is used instead of MCP_SERVER_URL above and
# the gateway exposes the tools of every listed server. Use forward slashes in
# Windows paths or the JSON will not parse. Never put credentials in this file
# if it is committed; values here are read-only defaults for local dev only.
# MCP_SERVERS=[{"name":"ollama","transport":"stdio","command":"python mcp/ollama_mcp.py"},{"name":"mongodb","transport":"stdio","command":"python mcp/mongodb_mcp.py"}]

# Risky tools (write/delete/execute/...) require an explicit approval decision.
MCP_REQUIRE_APPROVAL=true

# Comma-separated allowlist. The variable name must be MCP_ALLOWED_TOOLS_RAW to
# match the Settings field. Empty = the read-only default set.
MCP_ALLOWED_TOOLS_RAW=

# Cap on model -> tool -> model rounds per turn.
MCP_MAX_TOOL_ROUNDS=5

# Offer the model a synthetic "update_plan" tool and ask it to keep a short
# working plan. Advisory only: it never bypasses the allowlist or approval gates.
MCP_PLAN_MODE=false

MCP_TIMEOUT_SECONDS=60

# -- Gateway server ---------------------------------------------------------
# 7423, NOT 7420: :7420 is taken by vihokai-codex-agent
# (Codex/vihokai-codex-agent-v1/backend/_run_api.ps1 hardcodes 7420).
# :7421 = MCP2 clone, :7422 = MCP3 Codex API.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=7423

# When set, callers must send "Authorization: Bearer <key>".
# Leave empty for local development only.
GATEWAY_API_KEY=

# Comma-separated CORS origins. "*" allows all.
GATEWAY_CORS_ORIGINS=*
